{
  "name": "inference-hub",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "dev:api": "cargo run -p api",
    "dev:web": "pnpm --filter web dev",
    "seed": "cargo run -q -p seed",
    "seed:check": "cargo run -q -p seed -- --check",
    "dev:worker": "cargo run -p worker",
    "worker:once": "cargo run -q -p worker -- --once",
    "worker:retag": "cargo run -q -p worker -- --retag",
    "gen:api": "cargo run -q -p api --bin openapi > packages/api-client/openapi.json && pnpm --filter @inference-hub/api-client generate",
    "build:web": "pnpm --filter web build",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && pnpm -r lint",
    "typecheck": "pnpm -r typecheck && tsc -p .railway",
    "test": "cargo test --workspace",
    "worker:enrich": "cargo run -q -p worker -- --enrich-backlog"
  },
  "devDependencies": {
    "railway": "3.16.0",
    "typescript": "5.9.3"
  }
}
