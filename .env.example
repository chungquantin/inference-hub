# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://inference_hub:inference_hub@localhost:5434/inference_hub

# Rust API
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of origins allowed by CORS (browser calls from the web app)
CORS_ORIGINS=http://localhost:3000
# Apply pending migrations on API startup
RUN_MIGRATIONS=true
RUST_LOG=info,api=debug,tower_http=info

# Next.js web app (server-side calls to the API)
API_URL=http://127.0.0.1:4000

# Public origin of the web app (canonical URLs, sitemap, structured data)
SITE_URL=http://localhost:3000

# Enables the admin API and the /admin review pages. Both the API and the web
# server read it. At least 32 characters: openssl rand -hex 32
# ADMIN_TOKEN=

# Worker: jobs run at the same time
WORKER_CONCURRENCY=4

# Worker: GitHub token for repository stats. Optional; without it GitHub allows
# 60 requests per hour, enough for about 30 repositories. No scopes are needed.
# GITHUB_TOKEN=

# Worker: port of /healthz, /readyz and /metrics (Prometheus)
WORKER_METRICS_PORT=9090

# Logs: one JSON object per line instead of human-readable text (the Docker
# image sets json)
# LOG_FORMAT=json

# Pool size per process. Keep the sum over all processes below Postgres's
# max_connections (100 by default).
# DATABASE_MAX_CONNECTIONS=10

# Production compose (docker-compose.prod.yml) reads these from .env.prod:
# POSTGRES_USER=inference_hub
# POSTGRES_PASSWORD=
# POSTGRES_DB=inference_hub

# Worker: LLM news enrichment through Liquid Inference (any OpenAI-compatible
# origin works). Off unless both are set.
# LIQUID_BASE_URL=https://router.inference.ai.exchange
# LIQUID_API_KEY=
# LIQUID_MODEL=liquid.auto
# Most one call may cost, the most one pass may spend, and the most per 24 hours.
# LIQUID_CAP_USD_PER_CALL=0.01
# MAX_ENRICH_USD_PER_RUN=0.25
# MAX_ENRICH_USD_PER_DAY=1.00
# ENRICH_BATCH=20

# Web: public origin of the API, for the "API docs" link in the footer.
# PUBLIC_API_URL=https://api.example.com
