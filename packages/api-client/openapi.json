{
  "openapi": "3.1.0",
  "info": {
    "title": "Inference Hub API",
    "description": "Products, services and news of the inference market.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness and database connectivity.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/news": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List news in any review state. Defaults to the pending queue.",
        "operationId": "adminListNews",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Review state to list. Default `pending`.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/NewsStatus"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Keep items from this source (slug).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organization",
            "in": "query",
            "description": "Keep items about this organization (slug).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Text that the title or summary must contain.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page (1-100, default 24).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Items to skip (default 0).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_NewsItem"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/v1/admin/news/review": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Approve, reject or return items to the queue.",
        "operationId": "adminReviewNews",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResult"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/v1/admin/news/{id}/organizations": {
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Replace the organizations a news item is linked to.",
        "operationId": "adminSetNewsOrganizations",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "News item id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetOrganizationsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewsItem"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/v1/admin/sources": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List feed sources with their fetch health, failing ones first.",
        "operationId": "adminListSources",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceStatus"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/v1/categories": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "List all categories of the market taxonomy.",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/categories/{slug}": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "Get one category by slug.",
        "operationId": "getCategory",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Category slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/news": {
      "get": {
        "tags": [
          "news"
        ],
        "summary": "List published news, newest first.",
        "operationId": "listNews",
        "parameters": [
          {
            "name": "organization",
            "in": "query",
            "description": "Keep items about this organization (slug).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Keep items from this source (slug).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Text that the title or summary must contain.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page (1-100, default 24).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Items to skip (default 0).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_NewsItem"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations": {
      "get": {
        "tags": [
          "organizations"
        ],
        "summary": "List organizations, optionally filtered and searched.",
        "operationId": "listOrganizations",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "description": "Keep organizations that play this role.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrgKind"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Keep organizations listed in this category.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Free-text search over name, tagline and description.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page (1-100, default 24).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Items to skip (default 0).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Organization"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{slug}": {
      "get": {
        "tags": [
          "organizations"
        ],
        "summary": "Get the full profile of one organization.",
        "operationId": "getOrganization",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Organization slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "List products, optionally filtered and searched.",
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Keep products of this type.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProductType"
            }
          },
          {
            "name": "organization",
            "in": "query",
            "description": "Keep products made by this organization (slug).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "open_weights",
            "in": "query",
            "description": "Keep models with (true) or without (false) open weights.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Free-text search over name, tagline and description.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page (1-100, default 24).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Items to skip (default 0).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ProductSummary"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{slug}": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Get one product with its model attributes and current offerings.",
        "operationId": "getProduct",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Product slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sitemap": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "List the slugs of every category, organization and product with their last update.",
        "operationId": "getSitemap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SitemapIndex"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "description": "A node of the market taxonomy, such as \"GPU Clouds\".",
        "required": [
          "id",
          "slug",
          "name",
          "organization_count"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "organization_count": {
            "type": "integer",
            "format": "int64",
            "description": "Number of organizations listed in this category."
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error body returned by every failing endpoint.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable code: `bad_request`, `unauthorized`, `not_found` or `internal`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ModelSpec": {
        "type": "object",
        "description": "Technical attributes of a model.",
        "required": [
          "modalities",
          "open_weights"
        ],
        "properties": {
          "active_params_b": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Parameters active per token, in billions (mixture-of-experts models)."
          },
          "context_window": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Context window, in tokens."
          },
          "family": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "modalities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Input modalities, such as `text` or `image`."
          },
          "open_weights": {
            "type": "boolean"
          },
          "parameters_b": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Total parameters, in billions."
          }
        }
      },
      "NewsItem": {
        "type": "object",
        "description": "A news item as shown in feeds.",
        "required": [
          "id",
          "url",
          "title",
          "published_at",
          "status",
          "organizations"
        ],
        "properties": {
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewsMention"
            }
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/NewsStatus"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "NewsMatch": {
        "type": "string",
        "description": "How a news item was linked to an organization.",
        "enum": [
          "source",
          "title",
          "body",
          "manual"
        ]
      },
      "NewsMention": {
        "type": "object",
        "description": "An organization a news item is about.",
        "required": [
          "slug",
          "name",
          "matched_by"
        ],
        "properties": {
          "matched_by": {
            "$ref": "#/components/schemas/NewsMatch"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "NewsStatus": {
        "type": "string",
        "description": "Review state of a news item. Only approved items are public.",
        "enum": [
          "pending",
          "approved",
          "rejected"
        ]
      },
      "Offering": {
        "type": "object",
        "description": "The latest observation of a provider selling a product.",
        "required": [
          "id",
          "provider",
          "currency",
          "observed_at"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code of the prices."
          },
          "gpu_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "gpu_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "price_input_per_mtok": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "USD per million input tokens."
          },
          "price_output_per_mtok": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "USD per million output tokens."
          },
          "price_per_hour": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Price per instance-hour."
          },
          "provider": {
            "$ref": "#/components/schemas/OrganizationRef"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OrgKind": {
        "type": "string",
        "description": "The roles an organization plays in the market. One organization can hold several.",
        "enum": [
          "model_provider",
          "inference_provider",
          "llm_gateway",
          "gpu_cloud",
          "hyperscaler",
          "hardware",
          "open_source",
          "investor",
          "other"
        ]
      },
      "OrgStatus": {
        "type": "string",
        "enum": [
          "active",
          "acquired",
          "defunct"
        ]
      },
      "Organization": {
        "type": "object",
        "description": "An organization as shown in listings.",
        "required": [
          "id",
          "slug",
          "name",
          "kinds",
          "status"
        ],
        "properties": {
          "founded_year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "hq_country": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgKind"
            }
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrgStatus"
          },
          "tagline": {
            "type": [
              "string",
              "null"
            ]
          },
          "website": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OrganizationDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Organization"
          },
          {
            "type": "object",
            "required": [
              "links",
              "categories",
              "products",
              "served_products",
              "updated_at"
            ],
            "properties": {
              "categories": {
                "type": "array",
